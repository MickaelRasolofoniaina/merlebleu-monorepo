{
  "name": "merlebleu-monorepo",
  "version": "1.0.0",
  "description": "Merlebleu Monorepo - Shared, API, and App",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w @merlebleu/shared",
    "build:api": "npm run build -w @merlebleu/api",
    "build:app": "npm run build -w @merlebleu/ui",
    "start:shared": "npm run dev -w @merlebleu/shared",
    "start:api": "npm run start:dev -w @merlebleu/api",
    "start:app": "npm start -w @merlebleu/ui",
    "start:all": "concurrently --names \"shared,api,app\" \"npm run start:shared\" \"npm run start:api\" \"npm run start:app\"",
    "generate:barrels": "npm run barrels -w @merlebleu/shared",
    "test": "npm test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^5.3.3"
  }
}
